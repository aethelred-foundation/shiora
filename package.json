{
  "name": "@aethelred/shiora",
  "version": "1.0.0",
  "description": "Shiora Health AI — Women's Health Platform on Aethelred",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "perf": "node perf/load-test.mjs",
    "config:lint": "tsx scripts/prod-config-lint.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"*.{js,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"*.{js,mjs,json}\"",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm run test",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start:standalone": "node scripts/prepare-standalone.mjs && node .next/standalone/server.js"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@tanstack/react-query": "^5.17.9",
    "autoprefixer": "^10.4.17",
    "lucide-react": "^0.311.0",
    "next": "^15.5.21",
    "pg": "^8.22.0",
    "postcss": "^8.5.23",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3",
    "tailwindcss": "^3.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@jest/types": "^30.4.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/forms": "^0.5.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.5.21",
    "jest": "^30.4.1",
    "jest-environment-jsdom": "^30.4.1",
    "msw": "^2.1.4",
    "prettier": "^3.2.4",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "ws": "^8.21.0",
    "@babel/core": "^7.29.7",
    "js-yaml": "^4.3.0",
    "brace-expansion": "5.0.8"
  }
}
