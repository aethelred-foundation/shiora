{
  "name": "@aethelred/shiora",
  "version": "1.0.0",
  "description": "Shiora Health AI — Women's Health Platform on Aethelred",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build --webpack",
    "start": "next start -p 3001",
    "lint": "eslint src/ --ext .ts,.tsx,.js,.jsx --max-warnings=-1",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "npm run build && node scripts/e2e-smoke.mjs",
    "test:postgres": "node scripts/run-postgres-integration.mjs",
    "test:postgres:docker": "node scripts/run-postgres-docker-integration.mjs",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "audit:prod": "npm audit --omit=dev",
    "review:findings": "node scripts/review-findings-gate.mjs",
    "contracts:build": "forge build --contracts contracts",
    "contracts:test": "forge test --contracts contracts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm run test && npm run contracts:test",
    "release:check": "npm run review:findings && npm run validate && npm run test:postgres && npm run test:e2e && npm run audit:prod"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.17.9",
    "autoprefixer": "^10.4.27",
    "lucide-react": "^0.311.0",
    "next": "^16.2.4",
    "pg": "^8.20.0",
    "postcss": "^8.5.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.15.4",
    "tailwindcss": "^3.4.19",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/types": "^29.6.3",
    "@openzeppelin/contracts": "^5.0.2",
    "@tailwindcss/forms": "^0.5.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.5.14",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "msw": "^2.1.4",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "glob": ">=10.4.0",
    "@tootallnate/once": ">=3.0.1",
    "postcss": "^8.5.12"
  }
}
