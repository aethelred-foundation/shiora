# Shiora on Aethelred — systemd unit (testnet evaluation deployment)
#
# Install:
#   1. Adjust User/WorkingDirectory/ExecStart paths below (run `which node`
#      and `which npm` as the service user — nvm installs live under
#      ~/.nvm/versions/node/<ver>/bin and systemd does not read shell rc files).
#   2. Put runtime configuration in <WorkingDirectory>/.env.local (the
#      start:standalone prepare step copies it into the bundle each start).
#   3. sudo cp deploy/systemd/shiora.service /etc/systemd/system/
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now shiora
#   Logs: journalctl -u shiora -f

[Unit]
Description=Shiora on Aethelred (standalone, evaluation tier)
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=administrator
WorkingDirectory=/home/administrator/shiora
Environment=NODE_ENV=production
Environment=SHIORA_PREFLIGHT_MODE=evaluation
Environment=PORT=3005
# Absolute path to npm (see install note 1); bash -lc keeps nvm setups working.
ExecStart=/bin/bash -lc 'npm run start:standalone'
Restart=always
RestartSec=5
# The app serves PHI-shaped test data; keep the process contained.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
