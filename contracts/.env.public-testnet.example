# Deployment-only environment for contracts/scripts/deploy-public-testnet.js.
# Copy to a file outside version control, chmod 600, replace every placeholder,
# source it into the shell, and remove it from the host after deployment.
#
# Never copy SHIORA_DEPLOYER_PRIVATE_KEY into the application runtime env.

AETHELRED_TESTNET_RPC_URL=https://<public-testnet-evm-rpc>
SHIORA_DEPLOYER_PRIVATE_KEY=0x<funded-testnet-private-key>

# Confirm these policy values with the network/compliance owners before
# deployment. Comma-separate multiple values; do not leave the two required
# lists blank.
SHIORA_CEAP_ALLOWED_BACKENDS=<approved-confidentiality-backend>
SHIORA_CEAP_DATA_RESIDENCY=<approved-residency-code>
SHIORA_CEAP_MIN_VERIFICATION=
SHIORA_CEAP_ALLOWED_PLATFORMS=
SHIORA_CEAP_REQUIRE_VENDOR_ROOT=false
