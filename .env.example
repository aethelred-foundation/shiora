# Aethelred RPC endpoint
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.aethelred.org

# Shiora Health AI API
NEXT_PUBLIC_SHIORA_API_URL=https://api.shiora.health

# IPFS Gateway
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.ipfs.io/ipfs/

# Signed session secret for wallet-backed API auth (32+ chars required in production)
SHIORA_SESSION_SECRET=replace-with-a-long-random-secret-before-production

# Comma-separated browser origins allowed to call the API.
# Regulated production readiness requires HTTPS-only, non-local origins.
SHIORA_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://shiora.health,https://app.shiora.health

# Session lifetime for signed auth cookies
SHIORA_SESSION_TTL_HOURS=24

# Enable HSTS in production (disable only for local HTTP dev if needed)
SHIORA_ENABLE_HSTS=true

# For local development only. Keep false in production.
SHIORA_ALLOW_INSECURE_WALLET_HEADER=false

# Comma-separated admin wallet allowlist for privileged compliance/audit APIs.
SHIORA_ADMIN_WALLETS=aeth1replace-with-admin-wallet

# Emergency/demo escape hatch only. Keep false for regulated production.
SHIORA_ALLOW_DEMO_STORE_IN_PRODUCTION=false

# Store backend. Use `demo` only for local/dev; regulated production must use `postgres`.
SHIORA_STORE_BACKEND=demo

# Optional AES-GCM encryption key for local demo-store state.
# Use `openssl rand -base64 32`; not a substitute for a durable production database.
SHIORA_DEMO_STORE_ENCRYPTION_KEY=

# Required for regulated production deployments.
DATABASE_URL=postgresql://user:password@localhost:5432/shiora
