# Signed session secret for wallet-backed API auth (32+ chars required in production)
SHIORA_SESSION_SECRET=replace-with-a-long-random-secret-before-production

# Comma-separated browser origins allowed to call the API
SHIORA_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://shiora.health,https://app.shiora.health

# Session lifetime for signed auth cookies
SHIORA_SESSION_TTL_HOURS=24

# Leave false until HTTPS and domain setup are fully validated in production
SHIORA_ENABLE_HSTS=false

# For local development only. Keep false in production.
SHIORA_ALLOW_INSECURE_WALLET_HEADER=false

# Postgres datastore. When unset, an in-memory store is used (development only —
# data is not durable). Required for production: PHI/records, access grants,
# consent, marketplace, and role assignments are persisted here (encrypted).
DATABASE_URL=

# 32-byte key (base64 or 64-char hex) that wraps per-record data keys for PHI
# encryption at rest. Generate with: openssl rand -base64 32
# In production this MUST come from a managed KMS/HSM — see docs/COMPLIANCE.md.
SHIORA_DATA_ENCRYPTION_KEY=

# Current key-encryption-key version stamped onto newly sealed data (default 1).
SHIORA_DATA_ENCRYPTION_KEY_VERSION=1

# Key rotation: bump SHIORA_DATA_ENCRYPTION_KEY_VERSION and set
# SHIORA_DATA_ENCRYPTION_KEY to the new key, then keep each superseded key
# available as SHIORA_DATA_ENCRYPTION_KEY_V<n> so historical ciphertext still
# decrypts. Example after rotating from v1 to v2:
#   SHIORA_DATA_ENCRYPTION_KEY_V1=<the old v1 key>
SHIORA_DATA_ENCRYPTION_KEY_V1=

# ── Production key custody: HashiCorp Vault (preferred over the env key above) ──
# When these are set the KEK is read from Vault (KV v2) once at startup instead
# of from SHIORA_DATA_ENCRYPTION_KEY — the plaintext key never lives in config.
# The Vault secret at SHIORA_VAULT_KEK_PATH must contain:
#   current_version : "1"
#   v1, v2, ...      : 32-byte key material (base64 or 64-char hex) per version
# Rotation mirrors the env scheme: add v2 and bump current_version.
SHIORA_VAULT_ADDR=
SHIORA_VAULT_TOKEN=
SHIORA_VAULT_KEK_PATH=

# Production custody (docs/KEY_MANAGEMENT.md): Vault TRANSIT — the app
# submits DEKs for wrap/unwrap and the master key never enters app memory.
# Setting a Transit key name (with the Vault addr/token above) switches the
# entire PHI envelope path onto the Transit DekWrapper backend. TLS is
# required to a non-local Vault.
SHIORA_TRANSIT_KEY_NAME=

# ── Deployment profile (docs/PILOT_SCOPE.md) ──────────────────
# full (default) serves every implemented surface; pilot serves ONLY the pilot
# corridor and answers 503 FEATURE_DISABLED on deferred surfaces, enforced
# server-side at the middleware. Pilot deployments MUST set this explicitly.
# SHIORA_PROFILE=pilot

# ── Authorization / tenancy (docs/AUTHORIZATION.md §3) ────────
# Recorded on every authorization-decision snapshot. A single-organization
# pilot has one data domain; these make the field explicit from day one so the
# multi-tenant migration (per-record tenant columns + Postgres RLS) is additive.
# SHIORA_TENANT_ID=<partner organization id>
# SHIORA_DATA_DOMAIN_ID=<data domain / legal boundary id>
# SHIORA_AUTHZ_POLICY_VERSION=authz/v1

# ── Break-glass governance (docs/PILOT_SCOPE.md §5) ───────────
# Recorded on every emergency-access event. The operative legal basis is the
# pilot jurisdiction's health-data law + the partner's clinical/privacy policy
# (confirmed by counsel) — NOT a US HIPAA provision. Defaults are 'unconfigured'.
# SHIORA_JURISDICTION=AE-AZ
# SHIORA_BREAK_GLASS_POLICY_VERSION=adhics-bg/v1
# SHIORA_BREAK_GLASS_AUTHORITY=<partner organization name>

# ── Release provenance (docs/RELEASE_PROCESS.md) ──────────────
# Stamped automatically at build time (git SHA + build timestamp); CI may
# override SHIORA_GIT_SHA. The deploy pipeline should set the image digest so
# GET /api/system/release reports it.
# SHIORA_GIT_SHA=
# SHIORA_CONTAINER_DIGEST=

# ── L1 audit anchoring (audit Finding F5) ──
# The audit-chain head is hash-chained into a WORM anchor series (POST /api/anchors,
# admin) and broadcast to an EVM-compatible L1 when these are set, otherwise it is
# recorded locally (receipt status: local). The hash travels as tx calldata via
# eth_sendTransaction; the node holds SHIORA_L1_ANCHOR_FROM (no client-side signing).
# Point an external scheduler at POST /api/anchors for periodic anchoring.
SHIORA_L1_RPC_URL=
SHIORA_L1_ANCHOR_FROM=
SHIORA_L1_ANCHOR_TO=
# Chain id of the anchoring target, reported by GET /api/system/release.
# TESTNET ONLY until the Aethelred mainnet gate (external audit) has cleared.
SHIORA_L1_CHAIN_ID=

# Comma-separated wallet addresses with administrative authority to manage roles
# (the RBAC bootstrap allowlist). Addresses holding the 'government' role are
# also admins. Leave empty in development.
SHIORA_ADMIN_ADDRESSES=

# ── Observability ─────────────────────────────────────────────
# Log level for structured JSON logs: debug | info | warn | error (default info)
# SHIORA_LOG_LEVEL=info
# Bearer token authorizing a Prometheus scraper to read GET /api/system/metrics
# (min 16 chars). Unset = metrics are admin-session-only.
# SHIORA_METRICS_TOKEN=

# ── Postgres pool hardening (GAP-27) ──────────────────────────
# Max pooled connections (default 10)
# SHIORA_PG_POOL_MAX=10
# Per-statement timeout in ms, server- and client-side (default 30000)
# SHIORA_PG_STATEMENT_TIMEOUT_MS=30000
# Idle client recycle in ms (default 30000)
# SHIORA_PG_IDLE_TIMEOUT_MS=30000
# Connection acquisition timeout in ms (default 10000)
# SHIORA_PG_CONNECT_TIMEOUT_MS=10000

# ── Data retention (GAP-16) ───────────────────────────────────
# Days to keep soft-deleted rows before crypto-shredding them (storage
# limitation, GDPR Art. 5(1)(e)). Unset or 0 = retention disabled.
# SHIORA_RETENTION_DAYS=365
