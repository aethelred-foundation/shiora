# Aethelred RPC endpoint
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.aethelred.org

# Shiora Health AI API
NEXT_PUBLIC_SHIORA_API_URL=https://api.shiora.health

# IPFS Gateway
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.ipfs.io/ipfs/

# Signed session secret for wallet-backed API auth (32+ chars required in production)
SHIORA_SESSION_SECRET=replace-with-a-long-random-secret-before-production

# Comma-separated browser origins allowed to call the API
SHIORA_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://shiora.health,https://app.shiora.health

# Session lifetime for signed auth cookies
SHIORA_SESSION_TTL_HOURS=24

# Leave false until HTTPS and domain setup are fully validated in production
SHIORA_ENABLE_HSTS=false

# For local development only. Keep false in production.
SHIORA_ALLOW_INSECURE_WALLET_HEADER=false

# Postgres datastore. When unset, an in-memory store is used (development only —
# data is not durable). Required for production: PHI/records, access grants,
# consent, marketplace, and role assignments are persisted here (encrypted).
DATABASE_URL=

# 32-byte key (base64 or 64-char hex) that wraps per-record data keys for PHI
# encryption at rest. Generate with: openssl rand -base64 32
# In production this MUST come from a managed KMS/HSM — see docs/COMPLIANCE.md.
SHIORA_DATA_ENCRYPTION_KEY=

# Comma-separated wallet addresses with administrative authority to manage roles
# (the RBAC bootstrap allowlist). Addresses holding the 'government' role are
# also admins. Leave empty in development.
SHIORA_ADMIN_ADDRESSES=
