# Shiora public-testnet evaluation runtime.
# The Next.js UI and every /api route run in ONE process on canonical port 3001.
# Copy to .env.local, replace all placeholders, generate fresh secrets, and
# chmod 600 .env.local. Do not reuse the contract deployer key here.

NODE_ENV=production
PORT=3001
SHIORA_PREFLIGHT_MODE=evaluation
SHIORA_PROFILE=pilot

SHIORA_SESSION_SECRET=<openssl-rand-hex-48>
# This must exactly match the origin visible in the browser, including scheme
# and non-default port. TLS deployment example:
SHIORA_ALLOWED_ORIGINS=https://<public-testnet-app-host>
SHIORA_SESSION_TTL_HOURS=24
SHIORA_ENABLE_HSTS=true
SHIORA_ALLOW_INSECURE_WALLET_HEADER=false
SHIORA_TRUSTED_PROXY_COUNT=1

# Direct-IP, plain-HTTP access is permitted only for a synthetic-data
# evaluation. In that case replace the three values above with:
# SHIORA_ALLOWED_ORIGINS=http://<public-testnet-ip>:3001
# SHIORA_ENABLE_HSTS=false
# SHIORA_TRUSTED_PROXY_COUNT=0

# Required for a durable setup. For a local database on the same host,
# 127.0.0.1 is accepted without sslmode; remote Postgres must use
# sslmode=require, verify-ca, or verify-full.
DATABASE_URL=postgresql://<user>:<url-encoded-password>@127.0.0.1:5432/shiora
SHIORA_AUTO_MIGRATE=true

# Evaluation-only local KEK. Generate a new 32-byte value with:
#   openssl rand -hex 32
# Do not use this path for live patient data; production uses Vault Transit.
SHIORA_DATA_ENCRYPTION_KEY=<openssl-rand-hex-32>
SHIORA_DATA_ENCRYPTION_KEY_VERSION=1

# Comma-separated 0x EVM addresses allowed to administer Shiora.
SHIORA_ADMIN_ADDRESSES=<administrative-wallet-address>

SHIORA_LOG_LEVEL=info
SHIORA_RETENTION_DAYS=0

# L1 audit anchoring is deliberately disabled. There is no dedicated compatible
# anchor receiver on the public testnet yet. Leave ALL fields blank.
# ShioraSealAttestation is an attestation registry, not an audit-anchor target:
# never set SHIORA_L1_ANCHOR_TO to its address.
SHIORA_L1_RPC_URL=
SHIORA_L1_ANCHOR_FROM=
SHIORA_L1_ANCHOR_TO=
SHIORA_L1_CHAIN_ID=

# Leave managed inference disabled unless all three operator-controlled values
# are provisioned together.
SHIORA_INFERENCE_API_URL=
SHIORA_INFERENCE_API_KEY=
SHIORA_INFERENCE_DEPLOYMENT_ID=

# Fresh public-testnet evaluations may leave Vault unset and use the evaluation
# KEK above. Live-data production must configure Vault Transit instead.
SHIORA_VAULT_ADDR=
SHIORA_VAULT_TOKEN=
SHIORA_VAULT_KEK_PATH=
SHIORA_TRANSIT_KEY_NAME=
